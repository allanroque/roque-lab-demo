<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Healthcheck Dashboard · Ansible Automation Platform</title>
  <meta name="description" content="Inventário dinâmico da infraestrutura Red Hat — coletado pelo AAP">
  <style>
    *,*::before,*::after { margin:0; padding:0; box-sizing:border-box; }
    :root {
      --bg: #0B1020;
      --surface: #111A38;
      --surface-2: #18224A;
      --border: #22305E;
      --border-strong: #3A4B83;
      --text: #EEF2FF;
      --text-muted: #8A94BE;
      --accent: #EE0000;
      --accent-2: #FF6B35;
      --success: #00D4A6;
      --warn: #FFB347;
      --danger: #FF5577;
      --cyan: #21C6F0;
      --gradient: linear-gradient(135deg, #EE0000 0%, #FF6B35 60%, #FFB347 100%);
      --gradient-soft: linear-gradient(135deg, rgba(238,0,0,0.18), rgba(255,107,53,0.08));
    }
    html,body { height: 100%; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background: var(--bg); color: var(--text); line-height: 1.5;
      -webkit-font-smoothing: antialiased; overflow-x: hidden;
    }
    body::before {
      content: ""; position: fixed; inset: 0;
      background:
        radial-gradient(ellipse 60rem 30rem at 80% -10%, rgba(238,0,0,0.18), transparent 60%),
        radial-gradient(ellipse 50rem 25rem at 10% 0%, rgba(33,198,240,0.10), transparent 60%),
        radial-gradient(ellipse 40rem 30rem at 50% 110%, rgba(255,107,53,0.10), transparent 60%);
      pointer-events: none; z-index: 0;
    }
    body::after {
      content: ""; position: fixed; inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
      background-size: 48px 48px;
      mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
      -webkit-mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
      pointer-events: none; z-index: 0;
    }
    .container {
      max-width: 1280px; margin: 0 auto;
      padding: 3rem 1.5rem 4rem; position: relative; z-index: 1;
      animation: fadeUp 0.6s cubic-bezier(.2,.7,.2,1);
    }
    @keyframes fadeUp { from { opacity:0; transform: translateY(12px);} to { opacity:1; transform: translateY(0);} }

    .header {
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 1rem; margin-bottom: 2.5rem;
    }
    .brand { display: flex; align-items: center; gap: 0.875rem; }
    .brand-logo {
      width: 44px; height: 44px; border-radius: 12px;
      background: var(--gradient);
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 10px 28px rgba(238,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.2);
    }
    .brand-text h2 { font-size: 1rem; font-weight: 700; line-height: 1.2; }
    .brand-text p { font-size: 0.8125rem; color: var(--text-muted); }
    .status-pill {
      display: inline-flex; align-items: center; gap: 0.625rem;
      padding: 0.5rem 1rem;
      background: rgba(0,212,166,0.08); border: 1px solid rgba(0,212,166,0.28);
      border-radius: 999px; color: var(--success); font-size: 0.8125rem; font-weight: 600;
    }
    .status-dot {
      width: 0.5rem; height: 0.5rem; border-radius: 50%;
      background: var(--success); box-shadow: 0 0 0 4px rgba(0,212,166,0.15);
      animation: pulse 2s ease-in-out infinite;
    }
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1);} 50%{opacity:0.7;transform:scale(1.3);} }

    .hero { margin-bottom: 2.5rem; max-width: 880px; }
    .hero .eyebrow {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.375rem 0.75rem;
      background: var(--surface); border: 1px solid var(--border); border-radius: 999px;
      font-size: 0.75rem; font-weight: 600; color: var(--text-muted);
      letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 1rem;
    }
    .hero .eyebrow .dot { width: 6px; height: 6px; background: var(--accent-2); border-radius: 50%;}
    .hero h1 {
      font-size: clamp(2.25rem, 5vw, 3.75rem); line-height: 1.05;
      font-weight: 800; letter-spacing: -0.025em; margin-bottom: 1rem;
    }
    .hero h1 .gradient {
      background: var(--gradient);
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent; display: inline-block;
    }
    .hero .lede { font-size: 1.0625rem; color: var(--text-muted); max-width: 640px; }

    /* KPI bar */
    .kpis {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 0.875rem; margin-bottom: 2.5rem;
    }
    .kpi {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 14px; padding: 1rem 1.25rem; position: relative; overflow: hidden;
    }
    .kpi::before {
      content: ""; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: var(--gradient); opacity: 0.7;
    }
    .kpi .label {
      font-size: 0.6875rem; font-weight: 700; color: var(--text-muted);
      text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.375rem;
    }
    .kpi .value { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; font-variant-numeric: tabular-nums;}
    .kpi .sub   { font-size: 0.75rem; color: var(--text-muted); }

    /* Host cards */
    .hosts-grid {
      display: grid; gap: 1rem;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    }
    .host-card {
      position: relative; background: var(--surface);
      border: 1px solid var(--border); border-radius: 16px;
      padding: 1.5rem; overflow: hidden;
      transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
      text-decoration: none; color: inherit; display: block;
    }
    .host-card:hover { transform: translateY(-3px); border-color: var(--border-strong); box-shadow: 0 20px 40px -20px rgba(0,0,0,0.5); }
    .host-card::before {
      content: ""; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: var(--gradient); opacity: 0.7;
    }
    .host-card h3 {
      font-size: 1.125rem; font-weight: 700; margin-bottom: 0.25rem;
      display: flex; align-items: center; gap: 0.5rem; letter-spacing: -0.01em;
    }
    .host-card .sub {
      font-size: 0.8125rem; color: var(--text-muted);
      font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
      margin-bottom: 1rem;
    }
    .host-card .host-meta {
      display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem 1rem;
      padding-top: 0.875rem; border-top: 1px dashed var(--border);
      font-size: 0.8125rem;
    }
    .host-card .host-meta div { display: flex; flex-direction: column; gap: 0.125rem; }
    .host-card .host-meta .k { font-size: 0.6875rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.06em; }
    .host-card .host-meta .v { font-weight: 600; font-variant-numeric: tabular-nums; }
    .host-card .chips { display: flex; gap: 0.375rem; flex-wrap: wrap; margin-top: 0.875rem;}
    .chip {
      display: inline-flex; align-items: center; gap: 0.25rem;
      padding: 0.25rem 0.625rem; font-size: 0.6875rem;
      background: rgba(255,255,255,0.03); border: 1px solid var(--border);
      border-radius: 999px; color: var(--cyan);
      font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    }
    .chip-ok   { color: var(--success); border-color: rgba(0,212,166,0.3); }
    .chip-warn { color: var(--warn);    border-color: rgba(255,179,71,0.3); }

    .footer {
      margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border);
      display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;
      color: var(--text-muted); font-size: 0.8125rem;
    }
    .heart { color: var(--accent); animation: beat 1.5s ease-in-out infinite; display: inline-block;}
    @keyframes beat { 0%,100% { transform: scale(1);} 50% { transform: scale(1.15);} }
  </style>
</head>
<body>
  <div class="container">

    <div class="header">
      <div class="brand">
        <div class="brand-logo" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="#fff">
            <path d="M12 2L2.5 20.5h4.6l2-4.3h5.8l2 4.3h4.6L12 2zm-2.2 11.3L12 8.5l2.2 4.8H9.8z"/>
          </svg>
        </div>
        <div class="brand-text">
          <h2>Ansible Automation Platform</h2>
          <p>Healthcheck dinâmico · inventário da infra</p>
        </div>
      </div>
      <div class="status-pill">
        <span class="status-dot" aria-hidden="true"></span>
        Dashboard online · {{ hc_hosts | length }} host(s)
      </div>
    </div>

    <div class="hero">
      <span class="eyebrow"><span class="dot"></span>HC DASHBOARD · RED HAT INFRA</span>
      <h1>Inventário <span class="gradient">dinâmico</span>.</h1>
      <p class="lede">Relatório agregado gerado pelo Ansible Automation Platform. Cada card abre a página completa do host com identidade, hardware, subscrição, repositórios, serviços e top processos.</p>
    </div>

    <!-- KPIs ---------------------------------------------------------------- -->
    {%- set total_cpus = hc_hosts | map(attribute='hardware.cpus') | map('int') | sum %}
    {%- set total_ram_gb = hc_hosts | map(attribute='hardware.ram_gb') | map('float') | sum %}
    {%- set subs_ok = hc_hosts | selectattr('subscription.ok') | list | length %}
    {%- set total_services = hc_hosts | map(attribute='services.count_active_enabled') | map('int') | sum %}
    <div class="kpis">
      <div class="kpi">
        <div class="label">Hosts</div>
        <div class="value">{{ hc_hosts | length }}</div>
        <div class="sub">coletados neste ciclo</div>
      </div>
      <div class="kpi">
        <div class="label">Total vCPU</div>
        <div class="value">{{ total_cpus }}</div>
        <div class="sub">somatório da frota</div>
      </div>
      <div class="kpi">
        <div class="label">Total RAM</div>
        <div class="value">{{ total_ram_gb | round(1) }} GB</div>
        <div class="sub">somatório da frota</div>
      </div>
      <div class="kpi">
        <div class="label">Subscrição OK</div>
        <div class="value">{{ subs_ok }} / {{ hc_hosts | length }}</div>
        <div class="sub">hosts com status Current</div>
      </div>
      <div class="kpi">
        <div class="label">Serviços enabled</div>
        <div class="value">{{ total_services }}</div>
        <div class="sub">running + enabled</div>
      </div>
    </div>

    <!-- Host cards ---------------------------------------------------------- -->
    <div class="hosts-grid">
      {% for h in hc_hosts | sort(attribute='identity.hostname') %}
      <a class="host-card" href="host_{{ h.inventory_hostname }}.html">
        <h3>{{ h.identity.hostname }}</h3>
        <div class="sub">{{ h.identity.fqdn }} · {{ h.identity.ip }}</div>

        <div class="chips">
          <span class="chip">{{ h.os.distribution }} {{ h.os.major }}</span>
          <span class="chip">{{ h.hardware.architecture if h.hardware.architecture is defined else h.os.architecture }}</span>
          <span class="chip">{{ h.hardware.virtualization_type }}</span>
          {% if h.subscription.ok %}
          <span class="chip chip-ok">● subs OK</span>
          {% else %}
          <span class="chip chip-warn">▲ subs</span>
          {% endif %}
        </div>

        <div class="host-meta">
          <div><span class="k">CPU</span><span class="v">{{ h.hardware.cpus }} vCPU</span></div>
          <div><span class="k">RAM</span><span class="v">{{ h.hardware.ram_gb }} GB</span></div>
          <div><span class="k">Uptime</span><span class="v">{{ h.uptime.human }}</span></div>
          <div><span class="k">Serviços</span><span class="v">{{ h.services.count_active_enabled }} ✓</span></div>
          <div><span class="k">Repos</span><span class="v">{{ h.repositories | length }}</span></div>
          <div><span class="k">Mounts</span><span class="v">{{ h.storage | length }}</span></div>
        </div>
      </a>
      {% else %}
      <div class="host-card">
        <h3>Nenhum host coletado</h3>
        <div class="sub">Rode primeiro o playbook <code>collect_infra_report.yml</code>.</div>
      </div>
      {% endfor %}
    </div>

    <div class="footer">
      <div>Gerado em <strong style="color:var(--text);">{{ generated_at }}</strong> · de <strong style="color:var(--text);">{{ dashboard_host }}</strong></div>
      <div>Powered by <strong style="color:var(--text);">Red Hat Ansible</strong> <span class="heart">♥</span></div>
    </div>

  </div>
</body>
</html>
