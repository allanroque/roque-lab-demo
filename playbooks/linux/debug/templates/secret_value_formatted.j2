{# Formata um segredo para stdout conforme política de exibição (Survey / -e).
   Variáveis esperadas no contexto do lookup('template'):
   - secret_value (string)
   - password_display: plain | masked | length_only | partial | asterisk_same_len
   - partial_prefix, partial_suffix (int, só para partial)
   - long_secret_threshold (int) — valores maiores viram só mensagem de tamanho, exceto em plain
#}
{% set s = secret_value | default('', true) | string %}
{% set fmt = password_display | default('partial') %}
{% set pp = partial_prefix | default(2) | int %}
{% set ps = partial_suffix | default(1) | int %}
{% set long_thr = long_secret_threshold | default(128) | int %}
{% if s | length == 0 -%}
(not defined)
{%- elif s | length > long_thr and fmt != 'plain' -%}
[{{ s | length }} chars — omitted (limit {{ long_thr }}); Survey: debug_password_display=plain for lab only]
{%- elif fmt == 'plain' -%}
{{ s }}
{%- elif fmt == 'length_only' -%}
[{{ s | length }} chars]
{%- elif fmt == 'masked' -%}
<redacted>
{%- elif fmt == 'asterisk_same_len' -%}
{{ '*' * (s | length) }}
{%- elif fmt == 'partial' -%}
{%- if s | length <= pp + ps -%}
{{ '*' * (s | length) }}
{%- else -%}
{{ s[:pp] }}{{ '*' * (s | length - pp - ps) }}{{ s[-ps:] }}
{%- endif -%}
{%- else -%}
<redacted>
{%- endif %}
