<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edge Operations Center</title>
    <style>
        :root {
            --bg-primary: #06080f;
            --bg-secondary: #0d1117;
            --bg-card: #111827;
            --bg-card-hover: #162032;
            --border: #1e293b;
            --border-hover: #3b82f6;
            --text-primary: #f0f6fc;
            --text-secondary: #8b949e;
            --text-muted: #4b5563;
            --blue: #3b82f6;
            --blue-glow: rgba(59, 130, 246, 0.15);
            --green: #22c55e;
            --green-bg: #064e3b;
            --yellow: #f59e0b;
            --yellow-bg: #78350f;
            --red: #ef4444;
            --red-bg: #7f1d1d;
            --cyan: #06b6d4;
            --purple: #8b5cf6;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', -apple-system, sans-serif; background: var(--bg-primary); color: var(--text-primary); min-height: 100vh; }

        /* --- Layout --- */
        .app { display: flex; min-height: 100vh; }

        /* --- Sidebar --- */
        .sidebar {
            width: 280px; background: var(--bg-secondary); border-right: 1px solid var(--border);
            display: flex; flex-direction: column; position: fixed; top: 0; bottom: 0; z-index: 10;
            transition: transform 0.3s;
        }
        .sidebar-header {
            padding: 1.2rem 1.4rem; border-bottom: 1px solid var(--border);
        }
        .sidebar-header h1 { font-size: 1.1rem; color: var(--text-primary); }
        .sidebar-header h1 span { color: var(--blue); }
        .sidebar-header p { font-size: 0.72rem; color: var(--text-muted); margin-top: 4px; }
        .sidebar-search {
            margin: 0.8rem 1rem; padding: 0.5rem 0.8rem; background: var(--bg-card);
            border: 1px solid var(--border); border-radius: 8px; color: var(--text-primary);
            font-size: 0.85rem; width: calc(100% - 2rem); outline: none;
        }
        .sidebar-search:focus { border-color: var(--blue); }
        .sidebar-nav { flex: 1; overflow-y: auto; padding: 0.4rem 0; }
        .nav-section { padding: 0.6rem 1.2rem 0.3rem; font-size: 0.68rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1.5px; }
        .nav-item {
            display: flex; align-items: center; gap: 0.7rem; padding: 0.6rem 1.4rem;
            cursor: pointer; transition: background 0.15s; font-size: 0.88rem; color: var(--text-secondary);
            border-left: 3px solid transparent;
        }
        .nav-item:hover { background: var(--bg-card); color: var(--text-primary); }
        .nav-item.active { background: var(--blue-glow); color: var(--blue); border-left-color: var(--blue); }
        .nav-item .dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
        .nav-item .dot.online { background: var(--green); box-shadow: 0 0 6px var(--green); }
        .nav-item .dot.warning { background: var(--yellow); }
        .nav-item .dot.offline { background: var(--red); }
        .nav-item .store-meta { font-size: 0.7rem; color: var(--text-muted); margin-left: auto; }
        .sidebar-footer { padding: 1rem 1.4rem; border-top: 1px solid var(--border); font-size: 0.7rem; color: var(--text-muted); }

        /* --- Main --- */
        .main { flex: 1; margin-left: 280px; }
        .topbar {
            position: sticky; top: 0; z-index: 5; padding: 0.8rem 2rem;
            background: rgba(6, 8, 15, 0.85); backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border);
            display: flex; justify-content: space-between; align-items: center;
        }
        .topbar h2 { font-size: 1.05rem; font-weight: 600; }
        .topbar-meta { display: flex; gap: 1.5rem; font-size: 0.8rem; color: var(--text-secondary); }
        .content { padding: 1.5rem 2rem; }

        /* --- Overview Cards --- */
        .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
        .kpi {
            background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px;
            padding: 1.2rem 1.4rem; transition: border-color 0.2s;
        }
        .kpi:hover { border-color: var(--border-hover); }
        .kpi .label { font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; }
        .kpi .value { font-size: 2rem; font-weight: 700; margin-top: 0.3rem; }
        .kpi .value.ok { color: var(--green); }
        .kpi .value.warn { color: var(--yellow); }
        .kpi .value.bad { color: var(--red); }
        .kpi .sub { font-size: 0.78rem; color: var(--text-secondary); margin-top: 0.2rem; }

        /* --- Store Cards Grid (Overview) --- */
        .stores-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1.2rem; }
        .store-card {
            background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px;
            padding: 1.4rem; cursor: pointer; transition: all 0.25s; position: relative; overflow: hidden;
        }
        .store-card:hover { border-color: var(--blue); transform: translateY(-3px); box-shadow: 0 8px 30px rgba(0,0,0,0.3); }
        .store-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
            background: linear-gradient(90deg, var(--blue), var(--cyan));
        }
        .store-card.warning::before { background: linear-gradient(90deg, var(--yellow), #f97316); }
        .store-card.critical::before { background: linear-gradient(90deg, var(--red), #dc2626); }
        .store-card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; }
        .store-card-header h3 { font-size: 1rem; font-weight: 600; }
        .store-card-header .id { font-size: 0.75rem; color: var(--text-muted); }
        .store-status-badge {
            padding: 3px 10px; border-radius: 20px; font-size: 0.7rem; font-weight: 600;
        }
        .badge-ok { background: var(--green-bg); color: var(--green); }
        .badge-warn { background: var(--yellow-bg); color: var(--yellow); }
        .badge-critical { background: var(--red-bg); color: var(--red); }

        .store-card-devices { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; margin-bottom: 1rem; }
        .device-mini {
            background: var(--bg-primary); border-radius: 8px; padding: 0.6rem;
            text-align: center; font-size: 0.75rem;
        }
        .device-mini .count { font-size: 1.2rem; font-weight: 700; }
        .device-mini .dtype { color: var(--text-muted); font-size: 0.68rem; margin-top: 2px; }

        .store-card-services { display: flex; gap: 0.4rem; flex-wrap: wrap; }
        .svc-dot { width: 22px; height: 22px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 0.6rem; }
        .svc-dot.up { background: var(--green-bg); color: var(--green); }
        .svc-dot.down { background: var(--red-bg); color: var(--red); }

        .store-card-footer {
            display: flex; justify-content: space-between; align-items: center;
            margin-top: 0.8rem; padding-top: 0.8rem; border-top: 1px solid var(--border);
            font-size: 0.78rem; color: var(--text-secondary);
        }
        .view-link { color: var(--blue); text-decoration: none; font-weight: 600; font-size: 0.8rem; }
        .view-link:hover { text-decoration: underline; }

        /* --- Store Detail View --- */
        .detail-view { display: none; }
        .detail-view.active { display: block; }
        .overview-view.active { display: block; }

        .back-btn {
            background: var(--bg-card); border: 1px solid var(--border); color: var(--text-secondary);
            padding: 0.5rem 1rem; border-radius: 8px; cursor: pointer; font-size: 0.85rem;
            transition: all 0.2s; margin-bottom: 1.2rem; display: inline-flex; align-items: center; gap: 0.4rem;
        }
        .back-btn:hover { border-color: var(--blue); color: var(--text-primary); }

        .detail-header {
            background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px;
            padding: 1.5rem; margin-bottom: 1.2rem; display: flex; justify-content: space-between; align-items: center;
        }
        .detail-header h2 { font-size: 1.3rem; }
        .detail-header .meta { color: var(--text-secondary); font-size: 0.85rem; }
        .detail-links { display: flex; gap: 0.6rem; margin-top: 0.5rem; }
        .detail-link {
            background: var(--blue-glow); color: var(--blue); padding: 4px 12px;
            border-radius: 6px; font-size: 0.78rem; text-decoration: none;
        }
        .detail-link:hover { background: var(--blue); color: white; }

        .detail-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.2rem; }
        .detail-section {
            background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 1.3rem;
        }
        .detail-section h3 {
            font-size: 0.85rem; color: var(--blue); margin-bottom: 1rem;
            padding-bottom: 0.5rem; border-bottom: 1px solid var(--border);
            display: flex; align-items: center; gap: 0.5rem;
        }

        .device-row {
            display: flex; justify-content: space-between; align-items: center;
            padding: 0.7rem 0; border-bottom: 1px solid var(--border); font-size: 0.85rem;
        }
        .device-row:last-child { border-bottom: none; }
        .device-row .name { font-weight: 600; }
        .device-row .info { color: var(--text-secondary); font-size: 0.78rem; }
        .device-row .ip { font-family: 'Courier New', monospace; color: var(--cyan); font-size: 0.8rem; }

        .checklist-item {
            display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 0;
            border-bottom: 1px solid var(--border); font-size: 0.85rem;
        }
        .checklist-item:last-child { border-bottom: none; }
        .check-icon { width: 20px; height: 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; flex-shrink: 0; }
        .check-icon.pass { background: var(--green-bg); color: var(--green); }
        .check-icon.fail { background: var(--red-bg); color: var(--red); }
        .check-icon.warn { background: var(--yellow-bg); color: var(--yellow); }
        .check-label { flex: 1; }
        .check-value { color: var(--text-secondary); font-family: 'Courier New', monospace; font-size: 0.8rem; }

        .topo-diagram {
            display: flex; flex-direction: column; align-items: center; gap: 0.3rem; padding: 1rem 0;
        }
        .topo-row { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; }
        .topo-node {
            background: var(--bg-primary); border: 2px solid var(--border); border-radius: 10px;
            padding: 0.7rem 1rem; text-align: center; min-width: 110px; transition: border-color 0.2s;
        }
        .topo-node.up { border-color: var(--green); }
        .topo-node.down { border-color: var(--red); }
        .topo-node .icon { font-size: 1.3rem; }
        .topo-node .tname { font-size: 0.8rem; font-weight: 600; margin-top: 2px; }
        .topo-node .tip { font-size: 0.65rem; color: var(--text-muted); }
        .topo-pipe { width: 2px; height: 16px; background: var(--border); }

        .footer-bar {
            text-align: center; padding: 1.5rem; color: var(--text-muted); font-size: 0.72rem;
            border-top: 1px solid var(--border); margin-top: 2rem;
        }

        @media (max-width: 900px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.open { transform: translateX(0); }
            .main { margin-left: 0; }
            .stores-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="app">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <h1><span>&#9678;</span> Edge <span>Operations</span></h1>
                <p>Centro de Operações Edge</p>
            </div>
            <input type="text" class="sidebar-search" placeholder="Buscar loja..." oninput="filterStores(this.value)">
            <nav class="sidebar-nav">
                <div class="nav-section">Visão Geral</div>
                <div class="nav-item active" onclick="showOverview()">
                    <span>&#9632;</span> Todas as Lojas
                </div>
                <div class="nav-section">Lojas</div>
{% for store_id, devices in stores_data %}
{% set routers = devices | selectattr('store_role', 'equalto', 'router') | list %}
{% set servers = devices | selectattr('store_role', 'in', ['pdv', 'infra']) | list %}
{% set all_online = devices | selectattr('status', 'equalto', 'online') | list | length == devices | length %}
                <div class="nav-item" data-store="{{ store_id }}" onclick="showStore('{{ store_id }}')">
                    <span class="dot {{ 'online' if all_online else 'warning' }}"></span>
                    <span>{{ devices[0].store_name }}</span>
                    <span class="store-meta">{{ devices | length }}</span>
                </div>
{% endfor %}
            </nav>
            <div class="sidebar-footer">
                Gerado por Ansible Automation Platform<br>
                {{ ansible_date_time.iso8601 | default(now()) }}
            </div>
        </aside>

        <!-- Main Content -->
        <div class="main">
            <div class="topbar">
                <h2 id="page-title">Visão Geral - Todas as Lojas</h2>
                <div class="topbar-meta">
                    <span>&#128339; Atualizado: {{ ansible_date_time.time | default('--:--') }}</span>
                    <span>&#127759; {{ stores_data | length }} sites</span>
                </div>
            </div>

            <div class="content">
                <!-- ===== OVERVIEW ===== -->
                <div id="overview" class="overview-view active">
                    <div class="kpi-grid">
                        <div class="kpi">
                            <div class="label">Total de Lojas</div>
                            <div class="value">{{ stores_data | length }}</div>
                            <div class="sub">Sites Edge ativos</div>
                        </div>
                        <div class="kpi">
                            <div class="label">Routers Cisco</div>
{% set total_routers = all_devices | selectattr('store_role', 'equalto', 'router') | list | length %}
                            <div class="value">{{ total_routers }}</div>
                            <div class="sub">{{ total_routers }} online</div>
                        </div>
                        <div class="kpi">
                            <div class="label">Servidores PDV</div>
{% set total_pdv = all_devices | selectattr('store_role', 'equalto', 'pdv') | list | length %}
                            <div class="value">{{ total_pdv }}</div>
                            <div class="sub">App POS 3 camadas</div>
                        </div>
                        <div class="kpi">
                            <div class="label">Servidores Infra</div>
{% set total_infra = all_devices | selectattr('store_role', 'equalto', 'infra') | list | length %}
                            <div class="value">{{ total_infra }}</div>
                            <div class="sub">Syslog / NTP / TFTP</div>
                        </div>
                        <div class="kpi">
                            <div class="label">Dispositivos Online</div>
{% set total_online = all_devices | selectattr('status', 'equalto', 'online') | list | length %}
{% set total_devices = all_devices | length %}
                            <div class="value {{ 'ok' if total_online == total_devices else 'warn' }}">{{ total_online }}/{{ total_devices }}</div>
                            <div class="sub">{{ ((total_online / total_devices) * 100) | round(1) }}% disponibilidade</div>
                        </div>
                    </div>

                    <div class="stores-grid">
{% for store_id, devices in stores_data %}
{% set store_name = devices[0].store_name %}
{% set routers = devices | selectattr('store_role', 'equalto', 'router') | list %}
{% set pdv_servers = devices | selectattr('store_role', 'equalto', 'pdv') | list %}
{% set infra_servers = devices | selectattr('store_role', 'equalto', 'infra') | list %}
{% set online_count = devices | selectattr('status', 'equalto', 'online') | list | length %}
{% set total_count = devices | length %}
{% set health = 'ok' if online_count == total_count else ('critical' if online_count < (total_count / 2) else 'warning') %}
                        <div class="store-card {{ health }}" onclick="showStore('{{ store_id }}')">
                            <div class="store-card-header">
                                <div>
                                    <h3>{{ store_name }}</h3>
                                    <div class="id">ID: {{ store_id }}</div>
                                </div>
                                <span class="store-status-badge badge-{{ 'ok' if health == 'ok' else ('warn' if health == 'warning' else 'critical') }}">
                                    {{ 'Operacional' if health == 'ok' else ('Atenção' if health == 'warning' else 'Crítico') }}
                                </span>
                            </div>
                            <div class="store-card-devices">
                                <div class="device-mini">
                                    <div class="count">{{ routers | length }}</div>
                                    <div class="dtype">Routers</div>
                                </div>
                                <div class="device-mini">
                                    <div class="count">{{ pdv_servers | length }}</div>
                                    <div class="dtype">PDV</div>
                                </div>
                                <div class="device-mini">
                                    <div class="count">{{ infra_servers | length }}</div>
                                    <div class="dtype">Infra</div>
                                </div>
                            </div>
                            <div class="store-card-footer">
                                <span>{{ online_count }}/{{ total_count }} online</span>
                                <span class="view-link">Ver detalhes &#8594;</span>
                            </div>
                        </div>
{% endfor %}
                    </div>
                </div>

                <!-- ===== STORE DETAIL VIEWS ===== -->
{% for store_id, devices in stores_data %}
{% set store_name = devices[0].store_name %}
{% set routers = devices | selectattr('store_role', 'equalto', 'router') | list %}
{% set pdv_servers = devices | selectattr('store_role', 'equalto', 'pdv') | list %}
{% set infra_servers = devices | selectattr('store_role', 'equalto', 'infra') | list %}
                <div id="store-{{ store_id }}" class="detail-view">
                    <button class="back-btn" onclick="showOverview()">&#8592; Voltar para visão geral</button>

                    <div class="detail-header">
                        <div>
                            <h2>{{ store_name }}</h2>
                            <div class="meta">Store ID: {{ store_id }} &mdash; {{ devices | length }} dispositivos</div>
                            <div class="detail-links">
{% for pdv in pdv_servers %}
                                <a class="detail-link" href="http://{{ pdv.ip }}" target="_blank">&#128722; Abrir POS App</a>
{% endfor %}
{% for infra in infra_servers %}
                                <a class="detail-link" href="http://{{ infra.ip }}" target="_blank">&#9881; Painel Infra</a>
{% endfor %}
                            </div>
                        </div>
                        <span class="store-status-badge badge-ok">Operacional</span>
                    </div>

                    <div class="detail-grid">
                        <!-- Topologia -->
                        <div class="detail-section" style="grid-column: 1 / -1;">
                            <h3>&#127760; Topologia do Site</h3>
                            <div class="topo-diagram">
                                <div class="topo-row">
                                    <div class="topo-node up"><div class="icon">&#127744;</div><div class="tname">WAN</div><div class="tip">Link Internet</div></div>
                                </div>
                                <div class="topo-pipe"></div>
                                <div class="topo-row">
{% for r in routers %}
                                    <div class="topo-node {{ 'up' if r.status == 'online' else 'down' }}">
                                        <div class="icon">&#128421;</div>
                                        <div class="tname">{{ r.hostname }}</div>
                                        <div class="tip">{{ r.ip }}</div>
                                    </div>
{% endfor %}
                                </div>
                                <div class="topo-pipe"></div>
                                <div class="topo-row">
{% for s in pdv_servers %}
                                    <div class="topo-node {{ 'up' if s.status == 'online' else 'down' }}">
                                        <div class="icon">&#128722;</div>
                                        <div class="tname">PDV</div>
                                        <div class="tip">{{ s.ip }}</div>
                                    </div>
{% endfor %}
{% for s in infra_servers %}
                                    <div class="topo-node {{ 'up' if s.status == 'online' else 'down' }}">
                                        <div class="icon">&#9881;</div>
                                        <div class="tname">Infra</div>
                                        <div class="tip">{{ s.ip }}</div>
                                    </div>
{% endfor %}
                                </div>
                            </div>
                        </div>

                        <!-- Routers -->
                        <div class="detail-section">
                            <h3>&#128421; Routers Cisco ({{ routers | length }})</h3>
{% for r in routers %}
                            <div class="device-row">
                                <div>
                                    <div class="name">{{ r.hostname }}</div>
                                    <div class="info">{{ r.model }} &mdash; IOS {{ r.version }}</div>
                                </div>
                                <div>
                                    <div class="ip">{{ r.ip }}</div>
                                    <div class="info">SN: {{ r.serial }}</div>
                                </div>
                            </div>
{% endfor %}
                        </div>

                        <!-- Checklist Routers -->
                        <div class="detail-section">
                            <h3>&#9745; Checklist Rede</h3>
{% for r in routers %}
                            <div style="font-size: 0.78rem; color: var(--blue); font-weight: 600; padding: 0.5rem 0 0.2rem;">{{ r.hostname }}</div>
                            <div class="checklist-item">
                                <div class="check-icon pass">&#10003;</div>
                                <span class="check-label">Conectividade</span>
                                <span class="check-value">{{ r.status }}</span>
                            </div>
                            <div class="checklist-item">
                                <div class="check-icon {{ 'pass' if r.snmp else 'fail' }}">{{ '&#10003;' if r.snmp else '&#10007;' }}</div>
                                <span class="check-label">SNMP configurado</span>
                                <span class="check-value">{{ 'Sim' if r.snmp else 'Não' }}</span>
                            </div>
                            <div class="checklist-item">
                                <div class="check-icon {{ 'pass' if 'synchron' in (r.ntp | default('') | lower) else 'warn' }}">{{ '&#10003;' if 'synchron' in (r.ntp | default('') | lower) else '!' }}</div>
                                <span class="check-label">NTP sincronizado</span>
                                <span class="check-value">{{ 'Sim' if 'synchron' in (r.ntp | default('') | lower) else 'Verificar' }}</span>
                            </div>
                            <div class="checklist-item">
                                <div class="check-icon {{ 'pass' if r.vlans else 'warn' }}">{{ '&#10003;' if r.vlans else '!' }}</div>
                                <span class="check-label">VLANs configuradas</span>
                                <span class="check-value">{{ 'Sim' if r.vlans else 'Verificar' }}</span>
                            </div>
{% endfor %}
                        </div>

                        <!-- Servidor PDV -->
{% for s in pdv_servers %}
                        <div class="detail-section">
                            <h3>&#128722; Servidor PDV</h3>
                            <div class="checklist-item">
                                <div class="check-icon pass">&#10003;</div>
                                <span class="check-label">Sistema Operacional</span>
                                <span class="check-value">{{ s.os }}</span>
                            </div>
                            <div class="checklist-item">
                                <div class="check-icon pass">&#10003;</div>
                                <span class="check-label">Endereço IP</span>
                                <span class="check-value">{{ s.ip }}</span>
                            </div>
                            <div class="checklist-item">
                                <div class="check-icon pass">&#10003;</div>
                                <span class="check-label">Kernel</span>
                                <span class="check-value">{{ s.kernel }}</span>
                            </div>
                            <div class="checklist-item">
                                <div class="check-icon pass">&#10003;</div>
                                <span class="check-label">CPUs</span>
                                <span class="check-value">{{ s.cpu_count }} vCPUs</span>
                            </div>
                            <div class="checklist-item">
{% set mem_pct = ((s.memory_total_mb | int - s.memory_free_mb | int) / s.memory_total_mb | int * 100) | round(0) %}
                                <div class="check-icon {{ 'pass' if mem_pct < 80 else ('warn' if mem_pct < 90 else 'fail') }}">{{ '&#10003;' if mem_pct < 80 else ('!' if mem_pct < 90 else '&#10007;') }}</div>
                                <span class="check-label">Memória</span>
                                <span class="check-value">{{ mem_pct }}% ({{ s.memory_total_mb }}MB)</span>
                            </div>
                            <div class="checklist-item">
{% set disk_val = s.disk_usage | replace('%', '') | int %}
                                <div class="check-icon {{ 'pass' if disk_val < 80 else ('warn' if disk_val < 90 else 'fail') }}">{{ '&#10003;' if disk_val < 80 else ('!' if disk_val < 90 else '&#10007;') }}</div>
                                <span class="check-label">Disco</span>
                                <span class="check-value">{{ s.disk_usage }}</span>
                            </div>
                            <div class="checklist-item">
                                <div class="check-icon pass">&#10003;</div>
                                <span class="check-label">Uptime</span>
                                <span class="check-value">{{ s.uptime }}</span>
                            </div>
                        </div>

                        <div class="detail-section">
                            <h3>&#128203; Serviços PDV</h3>
{% for svc in s.services_detail | default([]) %}
{% set svc_status = svc.status.ActiveState | default('unknown') %}
                            <div class="checklist-item">
                                <div class="check-icon {{ 'pass' if svc_status == 'active' else 'fail' }}">{{ '&#10003;' if svc_status == 'active' else '&#10007;' }}</div>
                                <span class="check-label">{{ svc.item }}</span>
                                <span class="check-value">{{ svc_status }}</span>
                            </div>
{% endfor %}
                            <div style="margin-top: 1rem; padding-top: 0.8rem; border-top: 1px solid var(--border);">
                                <a class="detail-link" href="http://{{ s.ip }}" target="_blank">&#128279; Abrir App POS ({{ s.ip }}:80)</a>
                                <a class="detail-link" href="http://{{ s.ip }}/api/health" target="_blank">&#128147; Health Check API</a>
                            </div>
                        </div>
{% endfor %}

                        <!-- Servidor Infra -->
{% for s in infra_servers %}
                        <div class="detail-section">
                            <h3>&#9881; Servidor Infra-Interna</h3>
                            <div class="checklist-item">
                                <div class="check-icon pass">&#10003;</div>
                                <span class="check-label">Sistema Operacional</span>
                                <span class="check-value">{{ s.os }}</span>
                            </div>
                            <div class="checklist-item">
                                <div class="check-icon pass">&#10003;</div>
                                <span class="check-label">Endereço IP</span>
                                <span class="check-value">{{ s.ip }}</span>
                            </div>
                            <div class="checklist-item">
                                <div class="check-icon pass">&#10003;</div>
                                <span class="check-label">CPUs</span>
                                <span class="check-value">{{ s.cpu_count }} vCPUs</span>
                            </div>
                            <div class="checklist-item">
{% set mem_pct = ((s.memory_total_mb | int - s.memory_free_mb | int) / s.memory_total_mb | int * 100) | round(0) %}
                                <div class="check-icon {{ 'pass' if mem_pct < 80 else ('warn' if mem_pct < 90 else 'fail') }}">{{ '&#10003;' if mem_pct < 80 else ('!' if mem_pct < 90 else '&#10007;') }}</div>
                                <span class="check-label">Memória</span>
                                <span class="check-value">{{ mem_pct }}% ({{ s.memory_total_mb }}MB)</span>
                            </div>
                            <div class="checklist-item">
{% set disk_val = s.disk_usage | replace('%', '') | int %}
                                <div class="check-icon {{ 'pass' if disk_val < 80 else ('warn' if disk_val < 90 else 'fail') }}">{{ '&#10003;' if disk_val < 80 else ('!' if disk_val < 90 else '&#10007;') }}</div>
                                <span class="check-label">Disco</span>
                                <span class="check-value">{{ s.disk_usage }}</span>
                            </div>
                            <div class="checklist-item">
                                <div class="check-icon pass">&#10003;</div>
                                <span class="check-label">Uptime</span>
                                <span class="check-value">{{ s.uptime }}</span>
                            </div>
                        </div>

                        <div class="detail-section">
                            <h3>&#128203; Serviços Infra</h3>
{% for svc in s.services_detail | default([]) %}
{% set svc_status = svc.status.ActiveState | default('unknown') %}
                            <div class="checklist-item">
                                <div class="check-icon {{ 'pass' if svc_status == 'active' else 'fail' }}">{{ '&#10003;' if svc_status == 'active' else '&#10007;' }}</div>
                                <span class="check-label">{{ svc.item }}</span>
                                <span class="check-value">{{ svc_status }}</span>
                            </div>
{% endfor %}
                            <div style="margin-top: 1rem; padding-top: 0.8rem; border-top: 1px solid var(--border);">
                                <a class="detail-link" href="http://{{ s.ip }}" target="_blank">&#128279; Painel Infra ({{ s.ip }}:80)</a>
                            </div>
                        </div>
{% endfor %}
                    </div>
                </div>
{% endfor %}
            </div>

            <div class="footer-bar">
                Edge Operations Center &mdash; Powered by <span style="color: var(--blue);">Ansible Automation Platform</span> &mdash; Report gerado em {{ ansible_date_time.iso8601 | default(now()) }}
            </div>
        </div>
    </div>

    <script>
        function showOverview() {
            document.querySelectorAll('.detail-view').forEach(v => v.classList.remove('active'));
            document.getElementById('overview').classList.add('active');
            document.getElementById('page-title').textContent = 'Visão Geral - Todas as Lojas';
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            document.querySelector('.nav-item:not([data-store])').classList.add('active');
        }

        function showStore(storeId) {
            document.getElementById('overview').classList.remove('active');
            document.querySelectorAll('.detail-view').forEach(v => v.classList.remove('active'));
            const detail = document.getElementById('store-' + storeId);
            if (detail) {
                detail.classList.add('active');
                const header = detail.querySelector('.detail-header h2');
                document.getElementById('page-title').textContent = header ? header.textContent : 'Loja ' + storeId;
            }
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            const navItem = document.querySelector(`.nav-item[data-store="${storeId}"]`);
            if (navItem) navItem.classList.add('active');
        }

        function filterStores(query) {
            const q = query.toLowerCase();
            document.querySelectorAll('.nav-item[data-store]').forEach(item => {
                const text = item.textContent.toLowerCase();
                item.style.display = text.includes(q) ? '' : 'none';
            });
            document.querySelectorAll('.store-card').forEach(card => {
                const text = card.textContent.toLowerCase();
                card.style.display = text.includes(q) ? '' : 'none';
            });
        }
    </script>
</body>
</html>
